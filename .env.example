# Copy to .env.local for local development

# PostgreSQL connection string
DATABASE_URL=postgresql://variants_admin:password@localhost:5432/variants

# AWS configuration
AWS_REGION=eu-west-2
VCF_BUCKET_NAME=variant-viewer-vcf-123456789012

# Secrets Manager (Lambda + ECS use this instead of DATABASE_URL)
# DB_SECRET_ARN=arn:aws:secretsmanager:eu-west-2:123456789012:secret:variant-viewer/db-credentials
